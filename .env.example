# Copie este arquivo para ".env" e preencha com as chaves do seu projeto Firebase
# (Console Firebase > Configurações do projeto > Seus apps > Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nome que aparece no topo do recibo impresso
VITE_NOME_NEGOCIO=Ateliê da Neinha
